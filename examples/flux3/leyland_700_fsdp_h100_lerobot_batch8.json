{
  "dataset": {
    "repo_id": "local/leyland_merged_500_with_corrections",
    "root": "/data/datasets/leyland_merged_500_with_corrections",
    "eval_split": 0.0,
    "streaming": false,
    "video_backend": "torchcodec",
    "image_transforms": {
      "enable": false
    }
  },
  "policy": {
    "path": "black-forest-labs/flux-3-action-so101",
    "device": "cuda",
    "dtype": "float32",
    "use_peft": false,
    "push_to_hub": false,
    "attn_mode": "torch",
    "compile_model": false,
    "gradient_checkpointing": true,
    "caption_dropout": 0.1,
    "augment": false,
    "optimizer_lr": 5e-05,
    "optimizer_lr_heads_multiplier": 1.0,
    "optimizer_betas": [
      0.9,
      0.99
    ],
    "optimizer_eps": 1e-08,
    "optimizer_weight_decay": 0.05,
    "optimizer_grad_clip_norm": 1.0,
    "scheduler_freeze_backbone_steps": 0,
    "scheduler_warmup_steps": 1600,
    "scheduler_warmup_steps_heads": 1600,
    "scheduler_decay_steps": 0,
    "scheduler_cooldown_steps": 0
  },
  "rename_map": {
    "observation.images.realsense": "observation.images.scene",
    "observation.images.front": "observation.images.wrist"
  },
  "peft": null,
  "ema": {
    "enable": false
  },
  "parallelism": {
    "dp_replicate": 1,
    "dp_shard": 8
  },
  "accelerator": {
    "mixed_precision": "bf16",
    "gradient_accumulation": {
      "steps": 8
    },
    "fsdp": {
      "wrap_modules": [
        "ModeBlock",
        "SingleStreamBlock"
      ],
      "reshard_after_forward": true,
      "cpu_offload": false
    }
  },
  "batch_size": 8,
  "steps": 80000,
  "seed": 42,
  "num_workers": 8,
  "prefetch_factor": 2,
  "persistent_workers": true,
  "dataloader_multiprocessing_context": "spawn",
  "use_policy_training_preset": true,
  "log_freq": 80,
  "env_eval_freq": 0,
  "eval_steps": 0,
  "max_eval_samples": 2048,
  "save_checkpoint": true,
  "save_freq": 20000,
  "checkpoint_format": "safetensors_dcp",
  "save_checkpoint_to_hub": false,
  "wandb": {
    "enable": true,
    "project": "pickplace",
    "disable_artifact": true
  },
  "job_name": "flux3_leyland_700_fsdp_lerobot_batch8",
  "output_dir": "/data/outputs/flux3_leyland_700_fsdp_lerobot_run7_batch8"
}
